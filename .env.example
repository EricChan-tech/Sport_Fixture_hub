# Public schedule origin. Empty uses same-origin /schedule, then falls back to /fixtures.
# Example: https://cdn.example.com
VITE_SCHEDULE_BASE=
# Dev-only token sent by the browser. Leave empty locally. Do not put a production secret here.
VITE_SCHEDULE_JOB_TOKEN=

# Server-side only. Never prefix these with VITE_.
# local writes .schedule-store on disk. That directory is ephemeral on Netlify
# Functions, so the function runtime stores the same keys in Netlify Blobs.
# Leave this as local for Vite and the check scripts.
SCHEDULE_STORE=local
SCHEDULE_STORE_DIR=.schedule-store
SCHEDULE_JOB_TOKEN=
SCHEDULE_REQUIRE_TOKEN=
RUNNER_EGRESS=local

# Reserved for S3 or R2. Those adapters are not wired yet.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed to use Blobs from outside a Netlify Function. Inside the function
# the platform injects the credentials and SCHEDULE_STORE=local is upgraded.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_AUTH_TOKEN=
